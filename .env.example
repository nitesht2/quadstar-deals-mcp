# ── Firecrawl (optional -- aggregator scraping, Amazon-only mode without it) ───
FIRECRAWL_API_KEY=***

# ── Discord Webhook (one-way notifications) ────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ── Discord Bot (deal cards with Approve/Reject buttons) ──────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# ── Amazon Associates ─────────────────────────────────────────────────────────
AMAZON_AFFILIATE_TAG=quadstar0e-20

# ── LLM brain: DeepSeek Flash (primary) + OpenRouter (free-tier fallback) ──────
# Primary — get your key at https://platform.deepseek.com/api_keys
# Model: deepseek-v4-flash (context caching automatic — $0.0028/1M cached input)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-v4-flash

# Fallback — used automatically when DeepSeek errors/rate-limits.
# Get your key at https://openrouter.ai/keys. Free models end in ":free".
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/owl-alpha

# ── Postiz (self-hosted social scheduler) ─────────────────────────────────────
# Start Postiz via Docker, connect social accounts, then fill these in.
# API key: Postiz UI → Settings → API Key
# Integration IDs: connect accounts in Postiz UI, then:
#   curl http://localhost:4007/api/integrations \
#     -H "Authorization: YOUR_API_KEY"
POSTIZ_API_URL=http://localhost:4007/api
# API key = the org apiKey: docker exec postiz-postgres psql -U postiz-user -d postiz-db-local -t -c 'select "apiKey" from "Organization";'
POSTIZ_API_KEY=
# Connected-channel integration IDs: GET {POSTIZ_API_URL}/public/v1/integrations -H "Authorization: <key>"
# POSTIZ_TWITTER_ID is the @quadstardeals X channel id — REQUIRED to post to X.
POSTIZ_TWITTER_ID=
POSTIZ_INSTAGRAM_ID=
POSTIZ_LINKEDIN_ID=
POSTIZ_TIKTOK_ID=
POSTIZ_FACEBOOK_ID=
POSTIZ_REDDIT_ID=
POSTIZ_BLUESKY_ID=
POSTIZ_THREADS_ID=
# Image uploads use internal Postiz media API (bypasses the public API limitation).
# JWT_SECRET: copy from docker-compose.yaml → JWT_SECRET env var for the postiz service.
# USER_ID: UUID of the Postiz user — query via:
#   docker exec postiz-postgres psql -U postiz -c 'SELECT id FROM "User" WHERE email='\''your@email.com'\'';'
# USER_EMAIL: email you used when creating the Postiz account.
POSTIZ_JWT_SECRET=
POSTIZ_USER_ID=
POSTIZ_USER_EMAIL=

# ── Reply Guy — separate Discord channel for reply suggestions ────────────────
# Create a new channel in Discord, right-click → Copy ID
DISCORD_REPLY_CHANNEL_ID=

# ── X/Twitter API (for posting replies directly — separate from Postiz) ───────
# Get from developer.x.com → Your App → Keys and Tokens
# Bearer token = read-only (fetching tweets)
# OAuth 1.0a = write access (posting replies)
X_BEARER_TOKEN=***59|X_A...KEN=
X_ACCESS_TOKEN_SECRET=***

# ── Brand (change to rename the project -- zero code changes needed) ──────────
BRAND_NAME=QuadStar Deals
BRAND_HASHTAG=#QuadStarDeals

# ── Pipeline gates (tune per niche) ──────────────────────────────────────────
# Min discount % for auto-post (default 35, lowered to 25 for broader coverage)
PIPELINE_MIN_DISCOUNT=25
# Min deal score 0-100 (default 58)
PIPELINE_MIN_SCORE=58
# Min LLM content confidence 0-1 (default 0.85)
PIPELINE_MIN_CONFIDENCE=0.85
# Max auto-posts to X per calendar day — best-scored deals post first (0 = no cap)
PIPELINE_MAX_DAILY_POSTS=4

# ── Server ────────────────────────────────────────────────────────────────────
# Run on port 8001 (8000 is taken by Hermes Agent)
# uvicorn src.api:app --host 0.0.0.0 --port 8001
